# This computer's Flamingo helper, started at login and kept running.
# Installed by scripts/install-agent.sh into ~/.config/systemd/user/.
[Unit]
Description=Flamingo agent (downloads and the page at 127.0.0.1:8421)
After=network-online.target

[Service]
ExecStart=%h/.local/bin/flamingo agent run
Restart=on-failure
RestartSec=5
# yt-dlp and node often live in ~/.local/bin or nvm; a user unit's PATH
# is short, so add the usual places.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
